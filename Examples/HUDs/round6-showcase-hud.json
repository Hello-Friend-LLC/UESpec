            "style": {
              "fontSize": "@size.statusBar.label",
              "fontColor": "@color.white"
            }
          }
        ]
      },
      {
        "type": "HorizontalBox",
        "id": "skillRow",
        "children": [
          {
            "type": "SkillSlot",
            "id": "primarySkillSlot",
