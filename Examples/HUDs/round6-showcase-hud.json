{
  "apiVersion": "0.2",
  "kind": "HUD",
  "name": "Round6ShowcaseHUD",
  "description": "Integrated Round 6 showcase that wires all 12 built-in components into one ARPG/MMO-ready overlay.",
  "viewModel": {
    "class": "VM_Round6Showcase",
    "bindingMode": "manual"
