          "fontColor": "@color.white"
        }
      },
      {
        "type": "TextBlock",
        "id": "playerLevel",
        "content": { "bind": "vm.PlayerLevel" },
        "style": {
          "fontSize": 14,
          "fontColor": "@color.ui.hint"
        }
      },
      {
        "type": "HealthBar",
        "id": "playerHealthShell",
        "children": [
          {
            "type": "ProgressBar",
            "id": "playerHealthBar",
            "content": { "bind": "vm.PlayerHealthRatio" },
            "style": {
              "fillColor": "@color.health.fill",
              "backgroundColor": "@color.health.background"
            }
          },
          {
            "type": "TextBlock",
            "id": "playerHealthValue",
            "content": { "bind": "vm.PlayerHealthLabel" },
