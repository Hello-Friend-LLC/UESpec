{
  "apiVersion": "0.2",
  "kind": "HUD",
  "name": "CombatStatusHUD",
  "description": "Player-facing combat status strip with name, level, health, and resource.",
  "viewModel": {
    "class": "VM_CombatStatus",
    "bindingMode": "manual"
  },
  "root": {
    "type": "VerticalBox",
    "id": "combatHudRoot",
    "slot": {
      "anchors": "TopLeft",
      "alignment": [0.0, 0.0],
      "offset": [32, 32]
    },
    "children": [
      {
        "type": "TextBlock",
        "id": "playerName",
        "content": { "bind": "vm.DisplayName" },
        "style": {
          "fontSize": 20,
          "fontColor": "@color.white"
        }
      },
      {
        "type": "TextBlock",
        "id": "playerLevel",
        "content": { "bind": "vm.LevelLabel" },
        "style": {
          "fontSize": 14,
          "fontColor": "@color.ui.hint"
        }
      },
      {
        "type": "HealthBar",
        "id": "playerHealthShell",
        "children": [
          {
            "type": "ProgressBar",
            "id": "playerHealthBar",
            "content": { "bind": "vm.HealthRatio" },
            "style": {
              "fillColor": "@color.health.fill",
              "backgroundColor": "@color.health.background"
            }
          },
          {
            "type": "TextBlock",
            "id": "playerHealthValue",
            "content": { "bind": "vm.HealthLabel" },
            "style": {
              "fontSize": "@size.statusBar.label",
              "fontColor": "@color.white"
            }
          }
        ]
      },
      {
        "type": "ResourceBar",
        "id": "playerResourceShell",
        "visibility": { "bind": "vm.bShowResourceBar", "convert": "BoolToVisibility" },
        "children": [
          {
            "type": "ProgressBar",
            "id": "playerResourceBar",
            "content": { "bind": "vm.ResourceRatio" },
            "style": {
              "fillColor": "@color.resource.fill",
              "backgroundColor": "@color.resource.background"
            }
          },
          {
            "type": "TextBlock",
            "id": "playerResourceValue",
            "content": { "bind": "vm.ResourceLabel" },
            "style": {
              "fontSize": "@size.statusBar.label",
              "fontColor": "@color.white"
            }
          }
        ]
      }
    ]
  },
  "meta": {
    "generatedBy": "uespec-round6",
    "sourcePrompt": "Compact ARPG player status HUD with display name, level, health bar, and mana bar."
  }
}
