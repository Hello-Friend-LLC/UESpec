{
  "apiVersion": "0.2",
  "kind": "Test",
  "name": "Round6ShowcaseHUD_DefaultPresentation",
  "description": "Verify the integrated Round 6 showcase presents representative values for all built-in components.",
  "testSpec": {
    "target": "Round6ShowcaseHUD",
    "phases": {
      "assume": [
        { "step": "skill alert dot exists", "assertVisible": { "id": "skillAlertDot", "expected": true } },
        { "step": "buff icon exists", "assertVisible": { "id": "targetBuffIcon", "expected": true } },
        { "step": "tooltip title exists", "assertVisible": { "id": "itemTooltipTitle", "expected": true } }
      ],
      "assert": [
        { "step": "player name is shown", "assertText": { "id": "playerName", "expected": "Knight-01", "match": "Exact" } },
        { "step": "skill keybind is shown", "assertText": { "id": "skillKeybind", "expected": "Q", "match": "Exact" } },
        { "step": "target name is shown", "assertText": { "id": "targetName", "expected": "Warden of Ash", "match": "Exact" } },
        { "step": "damage number is shown", "assertText": { "id": "recentDamage", "expected": "-248!", "match": "Exact" } },
        { "step": "tracked quest progress is shown", "assertText": { "id": "trackedQuestProgress", "expected": "2 / 3 Relics", "match": "Exact" } },
        { "step": "equipped item power is shown", "assertText": { "id": "equippedItemPower", "expected": "+412", "match": "Exact" } },
        { "step": "tooltip summary is shown", "assertText": { "id": "itemTooltipSummary", "expected": "Legendary Helm - Power 412", "match": "Exact" } },
        { "step": "chat speaker is shown", "assertText": { "id": "chatSpeaker", "expected": "[Guild] Mira", "match": "Exact" } },
        { "step": "chat message is shown", "assertText": { "id": "chatMessage", "expected": "Meet at Ember Keep in 5.", "match": "Exact" } }
      ]
    }
  },
  "meta": {
    "generatedBy": "uespec-round6",
    "sourcePrompt": "Smoke test for the integrated Round 6 showcase HUD."
  }
}
