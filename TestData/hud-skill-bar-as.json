{
  "apiVersion": "0.2",
  "kind": "HUD",
  "name": "SkillBarASHUD",
  "viewModel": {
    "class": "VM_AsSample",
    "bindingMode": "manual",
    "scope": "PlayerState",
    "methods": [
      { "name": "UseSkill", "params": [{ "name": "Index", "type": "int" }], "pure": false },
      { "name": "ResetSkill", "params": [], "pure": false },
      { "name": "IsSkillReady", "params": [{ "name": "Index", "type": "int" }], "pure": true },
      { "name": "IsSkillLocked", "params": [{ "name": "Index", "type": "int" }], "pure": true }
    ]
  },
  "root": {
    "type": "VerticalBox",
    "id": "skillRoot",
    "children": [
      {
        "type": "Button",
        "id": "slotQ",
        "actions": [
          {
            "on": "Clicked",
            "do": "vm.UseSkill(0)",
            "guard": "vm.IsSkillReady(0)"
          }
        ]
      },
      {
        "type": "TextBlock",
        "id": "slotQ_label",
        "content": {
          "bind": "SkillLabel",
          "fallback": "AS Slash"
        }
      },
      {
        "type": "ProgressBar",
        "id": "slotQ_cooldownBar",
        "content": {
          "bind": "CooldownRatio",
          "fallback": 0.0
        },
        "visibility": {
          "bind": "bShowCooldown",
          "convert": "BoolToVisibility"
        }
      }
    ]
  }
}
